// ─── Venue + bookable surfaces ──────────────────────────────────────────────

/// Admin-side moderation status of a *single Venue listing* (distinct from the
/// account-level VENUE capability gate). PENDING until approved; SUSPENDED hides
/// it from the marketplace.
enum VenueVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// How a sport is sold, which decides the unit an owner types a price in during
/// venue setup. `Court.pricePerHour` stays the canonical stored rate — this only
/// governs entry and display, so a cricket ground can be listed per day and a
/// pool per person without a second price column.
enum SportPricingUnit {
  PER_HOUR
  PER_SLOT
  PER_SESSION
  PER_DAY
  PER_PERSON_SLOT
}

/// Whether one booking takes the whole surface (a futsal court) or a surface
/// sells N places per slot (a pool lane, a skating session).
enum SportBookingMode {
  EXCLUSIVE
  CAPACITY
}

/// A physical venue. `ownedVenues` relation links the primary owner (billing /
/// canonical contact); operational access is governed by VenueMembership.
/// `verificationStatus` is the per-listing admin moderation gate.
model Venue {
  id             String @id @default(cuid())
  primaryOwnerId String
  primaryOwner   User   @relation("UserOwnedVenues", fields: [primaryOwnerId], references: [id], onDelete: Cascade)

  name        String
  /// URL-safe handle derived from `name` at creation, unique platform-wide.
  ///
  /// IMMUTABLE. Staff login emails embed it (`ram@<slug>.arenanp.com`), so
  /// regenerating it on a rename would silently break every staff account at
  /// this venue with no traceable error. `updateProfile` must never touch it.
  slug        String @unique
  description String?

  address   String?
  city      String?
  country   String?  @default("Nepal")
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  coverImageUrl String?
  imageUrls     String[] @default([])
  documentUrls  String[] @default([])

  amenities          String[] @default([])
  /// Extra paid/free services, e.g. [{ "name": "Bib rental", "price": 50 }].
  additionalServices Json?

  /// Operating hours (venue-local "HH:mm"), used to bound bookable slots.
  openTime  String @default("06:00")
  closeTime String @default("22:00")

  contactEmail String?
  contactPhone String?

  verificationStatus VenueVerificationStatus @default(PENDING)
  rejectionReason    String?

  isFeatured Boolean   @default(false)
  featuredAt DateTime?

  reviewedById String?
  reviewer     User?     @relation("UserVenuesReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  memberships         VenueMembership[]
  courts              Court[]
  bookings            Booking[]
  settlements         Settlement[]
  tournaments         Tournament[]
  matches             Match[]
  venueSports         VenueSport[]
  offers              Offer[]
  customers           Customer[]
  membershipPlans     MembershipPlan[]
  subscriptions       Subscription[]
  closures            VenueClosure[]
  expenses            Expense[]
  cashReconciliations CashReconciliation[]
  bookingPayments     BookingPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus])
  @@index([city])
  @@index([isFeatured])
  @@index([primaryOwnerId])
  @@map("venues")
}

/// Whether a court is indoor, open-air, or netted/roofed without walls — a
/// per-court fact (monsoon decides bookings), never a sport-level chip.
enum CourtEnvironment {
  INDOOR
  OUTDOOR
  ROOFED
}

/// A bookable surface within a venue (court / ground / pitch). Pricing and
/// activation flag live here so a venue can have multiple sport types and
/// individually disabled courts without affecting the venue's verification.
model Court {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  name         String
  sportId      String
  sport        Sport             @relation(fields: [sportId], references: [id], onDelete: Restrict)
  pricePerHour Decimal           @db.Decimal(10, 2)
  /// Slot length in minutes (e.g. 60). Drives slot generation for bookings.
  slotMinutes  Int               @default(60)
  /// Per-court features from `Sport.courtFeatures`, e.g. ["Floodlights"].
  features     String[]          @default([])
  /// One of `Sport.surfaces` — "Wooden Floor" vs "Cement" changes the price.
  surface      String?
  /// One of `Sport.formats` — "5-a-side" vs "7-a-side" changes the headcount.
  format       String?
  environment  CourtEnvironment?
  /// Places per slot, for CAPACITY sports (a pool lane, a public skate).
  capacity     Int?
  description  String?
  isActive     Boolean           @default(true)
  imageUrls    String[]          @default([])

  bookings      Booking[]
  matches       Match[]
  subscriptions Subscription[]
  closures      VenueClosure[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@index([sportId])
  @@map("courts")
}

/// A venue-owner-initiated block on bookings for a time window. Covers both a
/// short block on one court (3–4 hrs) and a multi-day full-venue closure — the
/// difference is only the time span and whether `courtId` is set.
///
/// `courtId = null` blocks every court in the venue (a venue-wide closure);
/// a set `courtId` blocks just that court. Times are absolute UTC instants
/// (Nepal wall time converted at write), so the same overlap test the booking
/// flow uses works unchanged. Enforced at slot generation, walk-in create/edit,
/// and online player booking.
model VenueClosure {
  id      String  @id @default(cuid())
  venueId String
  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  courtId String?
  court   Court?  @relation(fields: [courtId], references: [id], onDelete: Cascade)

  startAt DateTime
  endAt   DateTime
  reason  String?

  createdById String?
  createdBy   User?   @relation("UserVenueClosuresCreated", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId, startAt])
  @@index([courtId, startAt])
  @@map("venue_closures")
}

/// Platform-managed catalogue of sports. The admin manages this list at
/// /admin/sports. Every Court / Tournament FK references one of these rows,
/// every Venue can offer many via the `venue_sports` junction, and only sports
/// with `isActive = true` should appear in the public marketplace filters.
model Sport {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  iconUrl      String?
  description  String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  // ── How the sport is sold ───────────────────────────────────────────────
  // Everything a client needs to render venue setup for this sport without
  // knowing its slug. Adding a sport here must never require a deploy.

  /// The unit an owner types a price in. Storage stays `Court.pricePerHour`.
  pricingUnit        SportPricingUnit @default(PER_HOUR)
  /// What the bookable thing is called — "court", "pitch", "lane", "table",
  /// "bay", "rink". Drives every label in venue setup ("Add table").
  unitLabel          String           @default("court")
  unitLabelPlural    String           @default("courts")
  /// Allowed booking slot lengths in minutes for this sport (e.g. [30, 60, 90, 120]).
  /// Admin-managed; shown as the slot-duration choices during venue setup.
  /// Must hold at least one entry — an empty list makes the sport unsellable.
  slotDurations      Int[]            @default([30, 60, 90, 120])
  /// Which of `slotDurations` a new court starts on. Must be a member.
  defaultSlotMinutes Int              @default(60)
  /// Booking duration bounds — a cricket ground has a 4-hour floor, a snooker
  /// table a 3-hour ceiling. Null means "no bound beyond the slot grid".
  minDurationMinutes Int?
  maxDurationMinutes Int?
  bookingMode        SportBookingMode @default(EXCLUSIVE)
  /// Places per slot, required when `bookingMode = CAPACITY`.
  defaultCapacity    Int?

  // ── Court attribute catalogues ──────────────────────────────────────────
  // The owner picks from these when setting up a court. Kept as three typed
  // lists rather than one bag of chips so each is filterable and single- vs
  // multi-select is unambiguous.

  /// Playing surfaces, e.g. ["Artificial Turf", "Concrete"]. Single-select per court.
  surfaces      String[] @default([])
  /// Configurations sold, e.g. ["5-a-side", "7-a-side"]. Single-select per court.
  formats       String[] @default([])
  /// Genuine per-court features, e.g. ["Floodlights", "Air-Conditioned"]. Multi-select.
  courtFeatures String[] @default([])

  // Note: extras (bibs, shuttles, a referee) are NOT here. Every venue charges
  // differently for them, so the owner enters their own with their own prices —
  // see `Venue.additionalServices`. Peak windows and booking windows are
  // likewise per-venue, not per-sport.

  /// DEPRECATED — derived on write as surfaces + formats + courtFeatures.
  /// Kept populated so the Expo app's venue setup keeps working unchanged
  /// until it moves to the typed lists above.
  features String[] @default([])

  createdById String?
  createdBy   User?   @relation("UserSportsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  venueSports  VenueSport[]
  courts       Court[]
  tournaments  Tournament[]
  statTypes    SportStatType[]
  periodConfig SportPeriodConfig?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@map("sports")
}

/// Many-to-many junction between Venue and Sport. A venue lists every sport
/// it offers here; individual Courts still FK directly to the specific Sport
/// they host.
model VenueSport {
  venueId String
  sportId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sport   Sport  @relation(fields: [sportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([venueId, sportId])
  @@index([sportId])
  @@map("venue_sports")
}

/// Admin-issued invitation that lets a venue operator set their password and
/// finish onboarding without going through the public KYC submission flow.
///
/// The link the admin sends contains a token of the form `<id>.<secret>`.
/// Only the argon2 hash of `secret` is stored — the raw token is sent in the
/// email and shown once (in dev) to the admin who issued it. Single-use:
/// `acceptedAt` is set when consumed.
model VenueInvitation {
  id String @id @default(cuid())

  email       String
  fullName    String?
  phoneNumber String?

  tokenHash  String
  expiresAt  DateTime
  acceptedAt DateTime?

  invitedById String
  invitedBy   User   @relation("UserVenueInvitationsCreated", fields: [invitedById], references: [id], onDelete: Cascade)

  createdUserId String?
  createdUser   User?   @relation("UserVenueInvitationsAccepted", fields: [createdUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([expiresAt])
  @@index([acceptedAt])
  @@map("venue_invitations")
}
