# compiled output
/dist
/node_modules
/build

# logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store
Thumbs.db

# tests
/coverage
/.nyc_output

# IDEs
.idea/
.vscode/
*.swp
*.swo

# env
.env
.env.local
.env.*.local

# prisma
prisma/migrations/dev.db*

# firebase
firebase-service-account.json
*.firebase-service-account.json

# tmp
.tmp/
tmp/
*.tsbuildinfo

# Compiled output belongs in dist/. A stray .js beside its .ts silently wins
# module resolution — ts-node loads it instead of the source, so edits appear to
# do nothing. 273 of these were once committed here.
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
prisma/**/*.js
prisma/**/*.d.ts
